        {
          "period": "Noite",
          "locationKey": "IdEstalagem",
          "activity": "balcão; é quando o jogador pode descansar"
        },
        {
          "period": "Madrugada",
          "locationKey": "IdEstalagem",
          "activity": "de pé no corredor do segundo andar, em frente à porta do quarto três"
        }
      ],
      "scheduleStatus": "catalog_data_not_evidence_of_runtime_movement"
    },
    {
